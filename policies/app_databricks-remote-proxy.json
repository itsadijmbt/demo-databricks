{
  "policy_id": "app:databricks-remote-proxy",
  "version": "0.2.7",
  "scope": "global",
  "resources": [
    "tool:databricks-remote-proxy/**"
  ],
  "constraints": {
    "denied_parameters": {
      "tool:databricks-remote-proxy/execute_sql": {
        "query": [
          "*DROP *",
          "*drop *",
          "*DELETE *",
          "*delete *",
          "*TRUNCATE*",
          "*truncate*",
          "*ALTER *",
          "*alter *",
          "*REVOKE*",
          "*revoke*",
          "*GRANT *",
          "*grant *",
          "*VACUUM*",
          "*vacuum*",
          "*hr_salaries*"
        ]
      },
      "tool:databricks-remote-proxy/execute_sql_read_only": {
        "query": [
          "*DROP *",
          "*drop *",
          "*DELETE *",
          "*delete *",
          "*INSERT *",
          "*insert *",
          "*UPDATE *",
          "*update *",
          "*ALTER *",
          "*alter *",
          "*CREATE *",
          "*create *",
          "*TRUNCATE*",
          "*truncate*",
          "*MERGE *",
          "*merge *",
          "*GRANT *",
          "*grant *",
          "*REVOKE*",
          "*revoke*",
          "*VACUUM*",
          "*vacuum*",
          "*COPY INTO*",
          "*copy into*",
          "*hr_salaries*"
        ]
      }
    },
    "parameters": {
      "tool:databricks-remote-proxy/execute_sql": {
        "query": {
          "max_length": 5000,
          "min_length": 1,
          "type": "string"
        }
      },
      "tool:databricks-remote-proxy/execute_sql_read_only": {
        "query": {
          "max_length": 5000,
          "min_length": 1,
          "type": "string"
        }
      }
    },
    "attestations": {
      "comp_change_approved": {
        "approval_criteria": "role:manager",
        "description": "Comp change above $10,000 -- requires a MANAGER's just-in-time sign-off",
        "one_time": true,
        "time_to_live": 300,
        "timeout": 300
      },
      "unclear_value": {
        "approval_criteria": "role:admin",
        "description": "Comp change with an unresolvable value (expression/subquery) -- ADMIN review",
        "one_time": true,
        "time_to_live": 300,
        "timeout": 300
      }
    }
  },
  "attestations": [
    "comp_change_approved::{ params.bonus_resolution == 'resolved' AND params.bonus > 10000 }",
    "unclear_value::{ params.bonus_resolution == 'unresolved' }"
  ],
  "description": "Databricks Managed MCP for XYZ fincorp ."
}
